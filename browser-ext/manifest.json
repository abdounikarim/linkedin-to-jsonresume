{
    "manifest_version": 3,
    "name": "JSON Resume Exporter",
    "description": "Export a profile page to JSON Resume",
    "icons": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon-16.png",
            "48": "icon-48.png",
            "128": "icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "*://*.linkedin.com/*"
    ],
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ]
}
